{
  "name": "cdk",
  "version": "0.1.0",
  "bin": {
    "cdk": "dist/cdk.js"
  },
  "scripts": {
    "build": "tsc --noemit && node build.js",
    "build:layer": "npm install --omit=dev && cd lambda && move ../node_modules nodejs/node_modules",
    "synth": "npm run build && cdk synth --no-version-reporting --no-path-metadata",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "cdk:deploy": "cdk deploy --no-version-reporting --no-path-metadata"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "aws-cdk": "2.1012.0",
    "aws-cdk-lib": "2.190.0",
    "constructs": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "esbuild": "^0.25.3"
  }
}
